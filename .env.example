# Copy to .env and adjust. The Makefile reads it. Write values without quotes.

# Token the local server accepts, and the one the scanner sends. Keep them equal,
# or set TERRAGRAPH_TOKEN to a tg_ token created under Settings (make up-sso).
TERRAGRAPH_INGEST_TOKEN=dev-token
TERRAGRAPH_TOKEN=dev-token

# Where the scanner sends reports.
TERRAGRAPH_API_URL=http://localhost:8080

# Postgres used by make test-db. Matches the stack from make up.
TERRAGRAPH_TEST_DATABASE_URL=postgres://terragraph:terragraph@localhost:5432/terragraph?sslmode=disable
