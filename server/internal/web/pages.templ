package web

import (
	"fmt"

	"github.com/WasathTheekshana/terragraph/server/internal/store"
)

templ projectsPage(all []store.Repo, shown []store.Repo, q listQuery, moduleSources int) {
	@layout("Projects", "projects") {
		@pageHeader("Projects", "Repositories of Terraform projects and how current their module versions are.")
		if len(all) == 0 {
			@emptyState("No projects scanned yet") {
				<p>Scan a repo or a folder of repos with the terragraph CLI, for example { " " }@code("terragraph scan --path ~/projects")</p>
			}
		} else {
			{{ s := summarizeRepos(all) }}
			@statGrid() {
				@stat("Terraform projects", s.Projects, toneMuted)
				@stat("Module calls", s.Calls, toneMuted)
				@stat("Outdated", s.Outdated, countTone(s.Outdated, toneWarn))
				@stat("Major behind", s.Behind, countTone(s.Behind, toneBad))
			}
			@searchForm("/", q, "Filter by repository")
			if moduleSources > 0 {
				<p class="mt-3 text-sm text-slate-500 dark:text-slate-400">
					{ plural(moduleSources, "scanned repository is a shared module", "scanned repositories are shared modules") }, so
					{ " " }<a href="/modules" class="text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">listed under Modules</a>.
				</p>
			}
			if len(shown) == 0 {
				@emptyState("No repositories match") {
					<p>Nothing matches “{ q.Q }”.</p>
				}
			} else {
				@table() {
					<thead>
						<tr>
							@sortTh(q, "/", "name", "Repository", false)
							@th("Branch", false)
							@sortTh(q, "/", "calls", "Module calls", true)
							@sortTh(q, "/", "outdated", "Outdated", true)
							@sortTh(q, "/", "behind", "Major behind", true)
							@sortTh(q, "/", "scanned", "Last scan", false)
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
						for _, r := range shown {
							<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
								<td class="px-4 py-3">
									<a href={ repoLink(r) } title={ r.RepoURL } class="font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">{ repoName(r.RepoURL) }</a>
									if r.Projects > 1 {
										<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{ fmt.Sprintf("%d Terraform projects", r.Projects) }</div>
									} else if p := projectPath(r.ProjectPath); p != "" {
										<div class="mt-0.5 font-mono text-xs text-slate-500 dark:text-slate-400">{ p }</div>
									}
								</td>
								<td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-slate-600 dark:text-slate-300">{ repoBranch(r) }</td>
								<td class="px-4 py-3 text-right tabular-nums">{ fmt.Sprint(r.ModuleCalls) }</td>
								<td class="px-4 py-3 text-right tabular-nums">
									@countBadge(r.OutdatedCalls, toneWarn)
								</td>
								<td class="px-4 py-3 text-right tabular-nums">
									@countBadge(r.MajorBehindCalls, toneBad)
								</td>
								<td class="px-4 py-3 whitespace-nowrap text-slate-500 dark:text-slate-400">{ formatTime(r.LastScanAt) }</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

templ repoPage(r store.Repo, projects []store.Project) {
	@layout(repoName(r.RepoURL), "projects") {
		@backLink("/", "All projects")
		<div class="mt-4">
			@namedHeader(repoName(r.RepoURL), r.RepoURL, fmt.Sprintf("%d Terraform projects · branch %s · last scanned %s", r.Projects, repoBranch(r), formatTime(r.LastScanAt)))
			@graphLink(fmt.Sprintf("/graph?repo=%d", r.ID))
		</div>
		@statGrid() {
			@stat("Terraform projects", r.Projects, toneMuted)
			@stat("Module calls", r.ModuleCalls, toneMuted)
			@stat("Outdated", r.OutdatedCalls, countTone(r.OutdatedCalls, toneWarn))
			@stat("Major behind", r.MajorBehindCalls, countTone(r.MajorBehindCalls, toneBad))
		}
		if r.ModuleID != nil {
			@moduleSourceNote(*r.ModuleID)
		}
		<h2 class="mt-10 text-lg font-semibold">Terraform projects</h2>
		@table() {
			<thead>
				<tr>
					@th("Project", false)
					@th("Module calls", true)
					@th("Outdated", true)
					@th("Major behind", true)
					@th("Last scan", false)
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
				for _, p := range projects {
					<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
						<td class="px-4 py-3">
							<a href={ projectURL(p.ID) } class="font-mono text-sm font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">{ rootLabel(p.Path) }</a>
						</td>
						<td class="px-4 py-3 text-right tabular-nums">{ fmt.Sprint(p.ModuleCalls) }</td>
						<td class="px-4 py-3 text-right tabular-nums">
							@countBadge(p.OutdatedCalls, toneWarn)
						</td>
						<td class="px-4 py-3 text-right tabular-nums">
							@countBadge(p.MajorBehindCalls, toneBad)
						</td>
						<td class="px-4 py-3 whitespace-nowrap text-slate-500 dark:text-slate-400">{ formatTime(p.LastScanAt) }</td>
					</tr>
				}
			</tbody>
		}
	}
}

templ moduleSourceNote(moduleID int64) {
	<p class="mt-6 rounded-md border border-slate-200 bg-slate-100 px-4 py-3 text-sm text-slate-800 dark:border-slate-700 dark:bg-slate-800/60 dark:text-slate-200">
		Projects use this repository as a shared module.
		{ " " }<a href={ moduleURL(moduleID) } class="font-medium underline">See the module and who uses it</a>.
	</p>
}

templ projectPage(p store.Project, repo store.Repo, usages []store.Usage) {
	@layout(repoName(p.RepoURL), "projects") {
		if repo.Projects > 1 {
			@backLink(repoURL(repo.ID), repoName(repo.RepoURL))
		} else if repo.ModuleID != nil {
			@backLink(moduleURL(*repo.ModuleID), repoName(repo.RepoURL))
		} else {
			@backLink("/", "All projects")
		}
		<div class="mt-4">
			@namedHeader(repoName(p.RepoURL), p.RepoURL, fmt.Sprintf("%sBranch %s · commit %s · scanned %s", pathPrefix(p.Path), p.LastBranch, shortSHA(p.LastCommitSHA), formatTime(p.LastScanAt)))
			@graphLink(fmt.Sprintf("/graph?project=%d", p.ID))
		</div>
		{{ s := summarizeUsages(usages) }}
		@statGrid() {
			@stat("Module calls", s.Calls, toneMuted)
			@stat("Up to date", s.UpToDate, toneMuted)
			@stat("Outdated", s.Outdated, countTone(s.Outdated, toneWarn))
			@stat("Major behind", s.Behind, countTone(s.Behind, toneBad))
		}
		if repo.ModuleID != nil {
			@moduleSourceNote(*repo.ModuleID)
		}
		if len(usages) == 0 {
			@emptyState("No module calls") {
				<p>The latest scan of this project found no <code>module</code> blocks.</p>
			}
		} else {
			<h2 class="mt-10 text-lg font-semibold">Module calls</h2>
			if n := nestedCount(usages); n > 0 {
				<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
					{ plural(n, "call is", "calls are") } made inside other modules, shown under the module that makes them.
				</p>
			}
			@callsTable(callTree(usages))
			if hasUnexpandedRemoteModules(usages) {
				<p class="mt-4 text-sm text-slate-500 dark:text-slate-400">
					Modules called inside remote modules are listed when the project has been initialized with { " " }@code("terraform init") { " " }before scanning.
				</p>
			}
		}
	}
}

// callsTable lists module calls as a tree: calls made inside another module
// are indented under it and marked nested.
templ callsTable(rows []callRow) {
	@table() {
		<thead>
			<tr>
				@th("Call", false)
				@th("Module", false)
				@th("Pinned", false)
				@th("Latest", false)
				@th("Status", false)
				@th("Location", false)
			</tr>
		</thead>
		<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
			for _, r := range rows {
				<tr class={ "hover:bg-slate-50 dark:hover:bg-slate-800/50", templ.KV("bg-slate-50/70 dark:bg-slate-900/60", r.Depth > 0) }>
					<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">
						<div class={ "flex items-center gap-1.5", indent(r.Depth) }>
							if r.Depth > 0 {
								<span class="text-slate-400 dark:text-slate-500" aria-hidden="true">↳</span>
							}
							<span class={ templ.KV("font-medium", r.Depth == 0) } title={ address(r.Usage) }>{ r.CallName }</span>
							if r.Depth > 0 {
								<span class="rounded bg-slate-100 px-1.5 py-0.5 font-sans text-[10px] font-medium tracking-wide text-slate-600 uppercase dark:bg-slate-800 dark:text-slate-300">nested</span>
							}
						</div>
					</td>
					<td class="px-4 py-3">
						if r.ModuleID != nil {
							<a href={ moduleURL(*r.ModuleID) } title={ orDash(r.ModuleKey) } class="text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">{ usageModuleName(r.Usage) }</a>
						} else {
							<span class="text-slate-500 dark:text-slate-400">{ r.Source }</span>
						}
					</td>
					<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">
						{ orDash(r.PinnedVersion) }
						if r.PinnedVersion == nil && r.RefDeclared != "" {
							<span class="text-slate-400 dark:text-slate-500">({ r.RefDeclared })</span>
						}
					</td>
					<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">{ orDash(r.LatestVersion) }</td>
					<td class="px-4 py-3">
						@badge(usageStatus(r.Usage))
					</td>
					<td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-slate-500 dark:text-slate-400">
						{ location(r.Usage) }
						if r.ResolutionSource == "modules-json" {
							<span title="Resolved from .terraform/modules/modules.json" class="ml-1 text-emerald-600 dark:text-emerald-400">verified</span>
						}
					</td>
				</tr>
			}
		</tbody>
	}
}

templ modulesPage(all []store.Module, shown []store.Module, q listQuery) {
	@layout("Modules", "modules") {
		@pageHeader("Modules", "Every module a project calls, with its latest release and who uses it.")
		if len(all) == 0 {
			@emptyState("No modules yet") {
				<p>Modules appear once a project that calls them is scanned. Scan module repos with { " " }@code("terragraph scan --mode module-repo --repo-url <url>") to learn their latest versions.</p>
			}
		} else {
			@searchForm("/modules", q, "Filter by module or source")
			if len(shown) == 0 {
				@emptyState("No modules match") {
					<p>Nothing matches “{ q.Q }”.</p>
				}
			} else {
				@table() {
					<thead>
						<tr>
							@sortTh(q, "/modules", "name", "Module", false)
							@th("Kind", false)
							@th("Latest", false)
							@sortTh(q, "/modules", "consumers", "Used by", true)
							@sortTh(q, "/modules", "outdated", "Outdated users", true)
							@sortTh(q, "/modules", "scanned", "Versions scanned", false)
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
						for _, m := range shown {
							<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
								<td class="px-4 py-3">
									<a href={ moduleURL(m.ID) } title={ m.Key } class="font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">{ moduleName(m.Key, m.Kind) }</a>
									if m.RepoID != nil {
										<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">source scanned</div>
									}
								</td>
								<td class="px-4 py-3 text-slate-600 dark:text-slate-300">{ m.Kind }</td>
								<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">{ orDash(m.LatestVersion) }</td>
								<td class="px-4 py-3 text-right tabular-nums">{ plural(m.Consumers, "project", "projects") }</td>
								<td class="px-4 py-3 text-right tabular-nums">
									@countBadge(m.OutdatedConsumers, toneWarn)
								</td>
								<td class="px-4 py-3 whitespace-nowrap text-slate-500 dark:text-slate-400">{ formatTime(m.VersionsScannedAt) }</td>
							</tr>
						}
					</tbody>
				}
			}
		}
	}
}

templ modulePage(m store.Module, consumers []store.Usage, deps []store.Usage) {
	@layout(moduleName(m.Key, m.Kind), "modules") {
		@backLink("/modules", "All modules")
		<div class="mt-4">
			@namedHeader(moduleName(m.Key, m.Kind), m.Key, fmt.Sprintf("%s module · latest %s · versions scanned %s", m.Kind, orDash(m.LatestVersion), formatTime(m.VersionsScannedAt)))
			@graphLink(fmt.Sprintf("/graph?module=%d", m.ID))
		</div>
		{{ s := summarizeUsages(consumers) }}
		@statGrid() {
			@stat("Projects", m.Consumers, toneMuted)
			@stat("Module calls", s.Calls, toneMuted)
			@stat("Outdated", s.Outdated, countTone(s.Outdated, toneWarn))
			@stat("Major behind", s.Behind, countTone(s.Behind, toneBad))
		}
		if m.LatestVersion == nil {
			<p class="mt-6 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800 dark:border-amber-500/30 dark:bg-amber-500/10 dark:text-amber-300">
				The latest version is unknown. Scan this module's repository with { " " }@code("terragraph scan --mode module-repo") to find it.
			</p>
		}
		if m.RepoID != nil {
			<h2 class="mt-10 text-lg font-semibold">What this module uses</h2>
			<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
				Modules called by this module's own code, from a scan of its
				{ " " }<a href={ repoURL(*m.RepoID) } class="text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">repository</a>.
			</p>
			if len(deps) == 0 {
				@emptyState("Uses no other modules") {
					<p>Its code has no <code>module</code> blocks.</p>
				}
			} else {
				{{ groups := groupByPath(deps) }}
				for _, g := range groups {
					if len(groups) > 1 {
						<h3 class="mt-6 font-mono text-sm font-medium text-slate-600 dark:text-slate-300">{ rootLabel(g.Path) }</h3>
					}
					@callsTable(g.Rows)
				}
			}
		} else if m.Kind == "git" {
			<p class="mt-6 text-sm text-slate-500 dark:text-slate-400">
				Scan this module's repository too, and the modules it uses will be listed here.
			</p>
		}
		if len(consumers) == 0 {
			@emptyState("No projects use this module") {
				<p>No project's current state calls it.</p>
			}
		} else {
			<h2 class="mt-10 text-lg font-semibold">Versions in use</h2>
			@table() {
				<thead>
					<tr>
						@th("Version", false)
						@th("Module calls", true)
						@th("Status", false)
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, v := range versionsInUse(consumers) {
						<tr>
							<td class="px-4 py-3 font-mono text-xs">{ v.Version }</td>
							<td class="px-4 py-3 text-right tabular-nums">{ fmt.Sprint(v.Calls) }</td>
							<td class="px-4 py-3">
								@badge(v.Status)
							</td>
						</tr>
					}
				</tbody>
			}
			<h2 class="mt-10 text-lg font-semibold">Used by</h2>
			@table() {
				<thead>
					<tr>
						@th("Project", false)
						@th("Call", false)
						@th("Pinned", false)
						@th("Status", false)
						@th("Location", false)
					</tr>
				</thead>
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, u := range consumers {
						<tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50">
							<td class="px-4 py-3">
								@projectName(u.ProjectRepoURL, u.ProjectPath, projectURL(u.ProjectID))
							</td>
							<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">
								{ u.CallName }
								if u.Parent != "" {
									<div class="mt-0.5 font-sans text-xs text-slate-500 dark:text-slate-400">{ via(u.Parent) }</div>
								}
							</td>
							<td class="px-4 py-3 font-mono text-xs whitespace-nowrap">{ orDash(u.PinnedVersion) }</td>
							<td class="px-4 py-3">
								@badge(usageStatus(u))
							</td>
							<td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-slate-500 dark:text-slate-400">{ location(u) }</td>
						</tr>
					}
				</tbody>
			}
		}
	}
}

templ errorPage(code int, title string, message string) {
	@layout(title, "") {
		<div class="py-16 text-center">
			<p class="text-sm font-semibold text-amber-700 dark:text-amber-400">{ fmt.Sprint(code) }</p>
			<h1 class="mt-2 text-2xl font-semibold tracking-tight">{ title }</h1>
			<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{ message }</p>
			<p class="mt-6">
				@backLink("/", "Back to projects")
			</p>
		</div>
	}
}
