package web

import (
	"fmt"

	"github.com/WasathTheekshana/terragraph/server/internal/envmatrix"
	"github.com/WasathTheekshana/terragraph/server/internal/store"
)

const chipLink = "rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs text-slate-700 hover:bg-amber-100 hover:text-amber-900 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-amber-500/20 dark:hover:text-amber-300"

templ resourcesPage(v resourcesView) {
	@layout("Resources", "resources") {
		<div class="flex flex-wrap items-end justify-between gap-4">
			@pageHeader("Resources", "What every scanned project creates and looks up, with the names, tags, and switches found in its source.")
			<a href="/resources/graph" class="text-sm font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">View resource dependencies →</a>
		</div>
		<form method="get" action="/resources" class="mt-8 flex flex-wrap items-center gap-2" role="search">
			if v.Filter.Type != "" {
				<input type="hidden" name="type" value={ v.Filter.Type }/>
			}
			if v.Filter.ProjectID != 0 {
				<input type="hidden" name="project" value={ fmt.Sprint(v.Filter.ProjectID) }/>
			}
			if v.Filter.RepoID != 0 {
				<input type="hidden" name="repo" value={ fmt.Sprint(v.Filter.RepoID) }/>
			}
			for _, t := range v.Query["tag"] {
				<input type="hidden" name="tag" value={ t }/>
			}
			<label for="q" class="sr-only">Search</label>
			<input
				id="q"
				type="search"
				name="q"
				value={ v.Filter.Query }
				placeholder="Search by address or name"
				class="w-full max-w-sm rounded-md border border-slate-300 bg-white px-3 py-1.5 text-sm placeholder:text-slate-400 focus:outline-2 focus:outline-offset-1 focus:outline-amber-500 dark:border-slate-700 dark:bg-slate-900"
			/>
			<label class="sr-only" for="mode">Kind</label>
			<select id="mode" name="mode" class={ graphSelect + " text-sm" }>
				<option value="" selected?={ v.Filter.Mode == "" }>Created and looked up</option>
				<option value="managed" selected?={ v.Filter.Mode == "managed" }>Created</option>
				<option value="data" selected?={ v.Filter.Mode == "data" }>Looked up</option>
			</select>
			<label class="sr-only" for="enabled">Switch</label>
			<select id="enabled" name="enabled" class={ graphSelect + " text-sm" }>
				<option value="" selected?={ v.Filter.Enabled == "" }>On or off</option>
				<option value="true" selected?={ v.Filter.Enabled == "true" }>On</option>
				<option value="false" selected?={ v.Filter.Enabled == "false" }>Off</option>
				<option value="unknown" selected?={ v.Filter.Enabled == "unknown" }>Unknown</option>
			</select>
			<button type="submit" class="rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200">Search</button>
		</form>
		if filters := v.activeFilters(); len(filters) > 0 {
			<ul class="mt-3 flex flex-wrap items-center gap-2 text-xs">
				for _, f := range filters {
					<li>
						<a href={ f.Undo } title="Remove this filter" class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2.5 py-1 font-medium text-amber-800 ring-1 ring-amber-600/20 ring-inset hover:bg-amber-100 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-500/20">
							{ f.Label } <span aria-hidden="true">×</span>
						</a>
					</li>
				}
				<li><a href="/resources" class="text-slate-500 hover:text-slate-900 dark:hover:text-white">Clear all</a></li>
			</ul>
		}
		if v.Total == 0 {
			@emptyState("No resources found") {
				if len(v.activeFilters()) > 0 || v.Filter.Query != "" {
					Nothing matches this filter.
				} else {
					Resources are recorded when a project is scanned. If projects are listed but nothing is here, scan them again with the current scanner.
				}
			}
		} else {
			<div class="mt-6 grid gap-6 lg:grid-cols-[16rem_1fr]">
				@resourceFacets(v)
				<div class="min-w-0">
					<p class="text-sm text-slate-500 dark:text-slate-400">
						Showing { fmt.Sprint(v.from()) }–{ fmt.Sprint(v.to()) } of { fmt.Sprint(v.Total) }
					</p>
					@table() {
						<thead>
							<tr>
								@th("Resource", false)
								@th("Project", false)
								@th("Name", false)
								@th("Tags", false)
								@th("Switch", false)
							</tr>
						</thead>
						<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
							for _, r := range v.Rows {
								@resourceRow(v, r)
							}
						</tbody>
					}
					@resourcePager(v)
				</div>
			</div>
		}
	}
}

templ resourceFacets(v resourcesView) {
	<aside class="space-y-6 text-sm">
		<section>
			<h2 class="text-xs font-medium tracking-wide text-slate-500 uppercase dark:text-slate-400">Resource types</h2>
			<ul class="mt-2 space-y-1">
				for _, c := range v.Facets.Types {
					<li class="flex items-baseline justify-between gap-2">
						<a
							href={ v.with("type", c.Value) }
							class={ "min-w-0 font-mono text-xs break-all hover:text-amber-700 dark:hover:text-amber-400", templ.KV("font-semibold text-amber-700 dark:text-amber-400", c.Value == v.Filter.Type) }
						>{ c.Value }</a>
						<span class="text-xs text-slate-400 tabular-nums">{ fmt.Sprint(c.Count) }</span>
					</li>
				}
			</ul>
		</section>
		if len(v.Facets.TagKeys) > 0 {
			<section>
				<h2 class="text-xs font-medium tracking-wide text-slate-500 uppercase dark:text-slate-400">Tags</h2>
				<ul class="mt-2 space-y-1">
					for _, c := range v.Facets.TagKeys {
						<li class="flex items-baseline justify-between gap-2">
							<a href={ v.with("tag", c.Value) } class="min-w-0 font-mono text-xs break-all hover:text-amber-700 dark:hover:text-amber-400">{ c.Value }</a>
							<span class="text-xs text-slate-400 tabular-nums">{ fmt.Sprint(c.Count) }</span>
						</li>
					}
				</ul>
			</section>
		}
		if v.Facets.TagKey != "" && len(v.Facets.TagValues) > 0 {
			<section>
				<h2 class="text-xs font-medium tracking-wide text-slate-500 uppercase dark:text-slate-400">Values of { v.Facets.TagKey }</h2>
				<ul class="mt-2 space-y-1">
					for _, c := range v.Facets.TagValues {
						<li class="flex items-baseline justify-between gap-2">
							<a href={ v.with("tag", tagFilter(v.Facets.TagKey, c.Value)) } class="min-w-0 font-mono text-xs break-all hover:text-amber-700 dark:hover:text-amber-400">{ c.Value }</a>
							<span class="text-xs text-slate-400 tabular-nums">{ fmt.Sprint(c.Count) }</span>
						</li>
					}
				</ul>
			</section>
		}
	</aside>
}

templ resourceRow(v resourcesView, r store.Resource) {
	<tr class="align-top hover:bg-slate-50 dark:hover:bg-slate-800/50">
		<td class="px-4 py-3">
			<div class="font-mono text-xs font-medium break-all">{ r.Address }</div>
			<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
				if r.Mode == "data" {
					looked up ·
				}
				{ r.File }:{ fmt.Sprint(r.Line) }
			</div>
		</td>
		<td class="px-4 py-3">
			@projectName(r.RepoURL, r.ProjectPath, projectURL(r.ProjectID))
		</td>
		<td class="px-4 py-3 font-mono text-xs break-all">
			{ displayName(r) }
			if rg := r.Attrs["resource_group_name"]; rg != "" {
				<div class="mt-0.5 text-slate-500 dark:text-slate-400">{ rg }</div>
			}
		</td>
		<td class="px-4 py-3">
			<div class="flex flex-wrap gap-1">
				for _, k := range sortedTags(r.Tags) {
					<a href={ v.with("tag", tagFilter(k, r.Tags[k])) } class={ chipLink }>{ k }={ r.Tags[k] }</a>
				}
				for _, k := range sortedTags(r.TagsUnresolved) {
					<span title={ r.TagsUnresolved[k] } class="rounded bg-amber-50 px-1.5 py-0.5 font-mono text-xs text-amber-800 dark:bg-amber-500/10 dark:text-amber-300">
						if k == "*" {
							tags set by an expression
						} else {
							{ k }=?
						}
					</span>
				}
			</div>
		</td>
		<td class="px-4 py-3 whitespace-nowrap">
			@badge(resourceState(r))
			if r.Condition != "" {
				<div class="mt-1 font-mono text-xs break-all whitespace-normal text-slate-500 dark:text-slate-400">{ r.Condition }</div>
			}
		</td>
	</tr>
}

templ resourcePager(v resourcesView) {
	if v.Pages > 1 {
		<nav class="mt-4 flex items-center justify-between text-sm" aria-label="Pages">
			if v.Page > 1 {
				<a href={ v.pageLink(v.Page - 1) } class="font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400">← Previous</a>
			} else {
				<span></span>
			}
			<span class="text-slate-500 dark:text-slate-400">Page { fmt.Sprint(v.Page) } of { fmt.Sprint(v.Pages) }</span>
			if v.Page < v.Pages {
				<a href={ v.pageLink(v.Page + 1) } class="font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400">Next →</a>
			} else {
				<span></span>
			}
		</nav>
	}
}

templ environmentsPage(v environmentsView) {
	@layout("Environments of "+repoName(v.Repo.RepoURL), "projects") {
		@backLink(repoURL(v.Repo.ID), repoName(v.Repo.RepoURL))
		<div class="mt-4 flex flex-wrap items-end justify-between gap-4">
			@namedHeader("Environments", v.Repo.RepoURL, "What each project in this repository creates, which switches are on, and where they differ.")
			if len(v.Matrix.Environments) > 1 && v.hasResources() {
				if v.OnlyDifferences {
					<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d/environments", v.Repo.ID)) } class="text-sm font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400">Show everything</a>
				} else {
					<a href={ templ.SafeURL(fmt.Sprintf("/repos/%d/environments?diff=1", v.Repo.ID)) } class="text-sm font-medium text-amber-700 hover:text-amber-900 dark:text-amber-400">Only show differences</a>
				}
			}
		</div>
		if len(v.Matrix.Environments) < 2 {
			@emptyState("Nothing to compare") {
				This repository has one Terraform project. Environments are the projects of one repository, such as envs/dev and envs/prod.
			}
		} else if !v.hasResources() {
			@emptyState("No resources recorded yet") {
				Scan these projects again with the current scanner to compare what they create.
			}
		} else {
			@statGrid() {
				@stat("Resources that differ", v.Matrix.Summary.Resources, countTone(v.Matrix.Summary.Resources, toneWarn))
				@stat("Switches that differ", v.Matrix.Summary.Flags, countTone(v.Matrix.Summary.Flags, toneWarn))
				@stat("Settings that differ", v.Matrix.Summary.Settings, countTone(v.Matrix.Summary.Settings, toneWarn))
				@stat("Tags that differ", v.Matrix.Summary.Tags, countTone(v.Matrix.Summary.Tags, toneWarn))
			}
			@matrixSection("Resources", len(v.Matrix.Resources), v.OnlyDifferences) {
				@matrixHead(v.Matrix.Environments, "Resource")
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, r := range v.Matrix.Resources {
						<tr class={ templ.KV("bg-amber-50/50 dark:bg-amber-500/5", r.Differs) }>
							<td class="px-4 py-2.5 align-top">
								<div class="font-mono text-xs font-medium break-all">{ r.Address }</div>
								if r.Mode == "data" {
									<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">looked up</div>
								}
							</td>
							for _, c := range r.Cells {
								<td class="px-4 py-2.5 align-top">
									@resourceCell(c)
								</td>
							}
						</tr>
					}
				</tbody>
			}
			@matrixSection("Feature switches", len(v.Matrix.Flags), v.OnlyDifferences) {
				@matrixHead(v.Matrix.Environments, "Variable")
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, r := range v.Matrix.Flags {
						@variableRow(r, true)
					}
				</tbody>
			}
			@matrixSection("Other settings", len(v.Matrix.Settings), v.OnlyDifferences) {
				@matrixHead(v.Matrix.Environments, "Variable")
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, r := range v.Matrix.Settings {
						@variableRow(r, false)
					}
				</tbody>
			}
			@matrixSection("Tags", len(v.Matrix.Tags), v.OnlyDifferences) {
				@matrixHead(v.Matrix.Environments, "Tag")
				<tbody class="divide-y divide-slate-100 dark:divide-slate-800">
					for _, r := range v.Matrix.Tags {
						<tr class={ templ.KV("bg-amber-50/50 dark:bg-amber-500/5", r.Differs) }>
							<td class="px-4 py-2.5 align-top font-mono text-xs font-medium break-all">{ r.Key }</td>
							for _, c := range r.Cells {
								<td class="px-4 py-2.5 align-top">
									if c.Resources == 0 {
										<span class="text-slate-400">–</span>
									} else {
										<div class="flex flex-wrap gap-1">
											for _, val := range c.Values {
												<span class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-xs dark:bg-slate-800">{ val }</span>
											}
										</div>
										<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{ fmt.Sprint(c.Resources) } resources</div>
									}
								</td>
							}
						</tr>
					}
				</tbody>
			}
		}
	}
}

templ matrixSection(title string, rows int, onlyDifferences bool) {
	<h2 class="mt-10 text-lg font-semibold">{ title }</h2>
	if rows == 0 {
		<p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
			if onlyDifferences {
				No differences.
			} else {
				None found.
			}
		</p>
	} else {
		@table() {
			{ children... }
		}
	}
}

templ matrixHead(envs []envmatrix.Environment, first string) {
	<thead>
		<tr>
			@th(first, false)
			for _, e := range envs {
				<th scope="col" class="bg-slate-50 px-4 py-2.5 text-left text-xs font-medium tracking-wide text-slate-500 dark:bg-slate-900 dark:text-slate-400">
					<a href={ projectURL(e.ProjectID) } class="font-mono normal-case hover:text-slate-900 dark:hover:text-white">{ envmatrix.Label(e) }</a>
					if !e.Scanned {
						<div class="font-normal normal-case">not scanned for resources</div>
					}
				</th>
			}
		</tr>
	</thead>
}

templ resourceCell(c envmatrix.ResourceCell) {
	if c.State == envmatrix.StateAbsent {
		<span class="text-slate-400" title="Not declared here">–</span>
	} else {
		@badge(environmentCellState(c))
		if c.Name != "" {
			<div class="mt-1 font-mono text-xs break-all text-slate-600 dark:text-slate-300">{ c.Name }</div>
		}
		if c.Condition != "" {
			<div class="mt-0.5 font-mono text-xs break-all text-slate-500 dark:text-slate-400">{ c.Condition }</div>
		}
	}
}

templ variableRow(r envmatrix.VariableRow, flag bool) {
	<tr class={ templ.KV("bg-amber-50/50 dark:bg-amber-500/5", r.Differs) }>
		<td class="px-4 py-2.5 align-top">
			<div class="font-mono text-xs font-medium break-all">{ variableName(r.ModulePath, r.Name) }</div>
			if len(r.Controls) > 0 {
				<div class="mt-0.5 text-xs break-all text-slate-500 dark:text-slate-400">switches { joinList(r.Controls) }</div>
			}
		</td>
		for _, c := range r.Cells {
			<td class="px-4 py-2.5 align-top">
				if !c.Present {
					<span class="text-slate-400" title="Not declared here">–</span>
				} else if flag && c.Value == "true" {
					@badge(status{"On", toneOK})
				} else if flag && c.Value == "false" {
					@badge(status{"Off", toneMuted})
				} else if c.Value == "" {
					<span class="text-xs text-slate-400" title="Only known when Terraform runs">unknown</span>
				} else {
					<span class="font-mono text-xs break-all">{ c.Value }</span>
				}
				if c.Present && c.Source != "" && c.Source != "default" {
					<div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">{ c.Source }</div>
				}
			</td>
		}
	</tr>
}
